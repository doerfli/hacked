<resources>

    <!-- Base application theme. Compose (HackedTheme) owns all in-app colour;
         this only sets the window before Compose draws and hosts the
         androidx.preference screens, which need a Material(Components) parent. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="TextTitle">
        <item name="android:textColor">@color/textHighEmphasis</item>
        <item name="android:paddingBottom">@dimen/card_title_padding_bottom</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Title</item>
        <item name="android:drawableBottom">@drawable/section_header</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="OverviewCard" >
        <item name="android:paddingLeft">@dimen/card_padding</item>
        <item name="android:paddingRight">@dimen/card_padding</item>
        <item name="android:paddingTop">@dimen/card_padding_short</item>
        <item name="android:paddingBottom">@dimen/card_padding</item>
    </style>

    <style name="TextNotice">
        <item name="android:textColor">@color/textMediumEmphasis</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TextBody">
        <item name="android:textColor">@color/textMediumEmphasis</item>
        <item name="android:textSize">14sp</item>
    </style>


    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>
